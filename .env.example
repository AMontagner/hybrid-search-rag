# demo runs without credentials; cloud requires all four provider settings
RAG_MODE=demo
DATA_DIR=data
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_RERANK_MODEL=rerank-v3.5
PINECONE_API_KEY=
# Full HTTPS host from your Pinecone index; index must have dimension 1024
PINECONE_HOST=
PINECONE_NAMESPACE=internal-docs
# Optional API protection; set before exposing outside localhost
APP_API_KEY=
